# Memex 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ============================================
# 服务配置
# ============================================

# HTTP 服务端口
PORT=10013

# ============================================
# 数据目录配置
# ============================================

# 主数据目录（存储数据库、向量索引等）
# 默认: ~/memex-data
# MEMEX_DATA_DIR=/path/to/memex-data

# 备份目录
# 默认: ~/memex-data/backups
# MEMEX_BACKUP_DIR=/path/to/backups

# ============================================
# Claude Code 配置
# ============================================

# Claude Code 项目目录路径
# 默认: ~/.claude/projects
# CLAUDE_PROJECTS_PATH=/Users/username/.claude/projects

# ============================================
# Ollama 配置（用于向量检索）
# ============================================

# Ollama API 地址
# 默认: http://localhost:11434/api
# OLLAMA_API=http://localhost:11434/api

# Embedding 模型名称
# 默认: nomic-embed-text
# 可选: bge-m3, nomic-embed-text 等
# EMBEDDING_MODEL=nomic-embed-text
