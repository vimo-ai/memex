# Memex 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ============================================
# 服务配置
# ============================================

# HTTP 服务端口
PORT=10013

# ============================================
# 数据目录配置
# ============================================

# 主数据目录（存储数据库、向量索引等）
# 默认: ~/memex-data
# MEMEX_DATA_DIR=/path/to/memex-data

# 备份目录
# 默认: ~/memex-data/backups
# MEMEX_BACKUP_DIR=/path/to/backups

# ============================================
# Claude Code 配置
# ============================================

# Claude Code 项目目录路径
# 默认: ~/.claude/projects
# CLAUDE_PROJECTS_PATH=/Users/username/.claude/projects

# ============================================
# Ollama 配置（用于向量检索）
# ============================================

# Ollama API 地址
# 默认: http://localhost:11434/api
# OLLAMA_API=http://localhost:11434/api

# Embedding 模型名称
# 默认: bge-m3
# 可选: bge-m3, bge-m3 等
# EMBEDDING_MODEL=bge-m3

# Chat 模型名称（用于 RAG 问答）
# 默认: qwen3:8b
# 可选: qwen3:8b, llama3.1, mistral 等
# CHAT_MODEL=qwen3:8b

# ============================================
# 功能开关
# ============================================

# 是否启用 RAG 问答功能
# 默认: false（需要额外的 LLM 模型，默认关闭）
# 设置为 true 或 1 启用
# ENABLE_RAG=false
